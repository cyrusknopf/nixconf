Checks: >
  -readability-identifier-length,
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  cppcoreguidelines-*

WarningsAsErrors: ''

Diagnostics:
  ClangTidy:
    Add: 
      # - modernize*
      - readability*
      - cppcoreguidelines-rvalue-reference-param-not-moved
      - performance-unnecessary-value-param
      - cppcoreguidelines-*
      - performance-*
      - bugprone-*

CompileFlags:
  Add: 
    - -std=c++20
    - -Wall
    - -Wextra
    - -Wshadow
    - -Wpendantic

